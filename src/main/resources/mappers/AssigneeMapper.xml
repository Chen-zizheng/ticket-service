<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.czz.ticket.mapper.AssigneeMapper">

    <select id="findAll" resultType="com.czz.ticket.domain.Assignee">
        SELECT id, name, team, active FROM assignee ORDER BY id
    </select>

    <select id="findById" resultType="com.czz.ticket.domain.Assignee">
        SELECT id, name, team, active FROM assignee WHERE id = #{id}
    </select>

    <select id="findByIds" resultType="com.czz.ticket.domain.Assignee">
        SELECT id, name, team, active FROM assignee
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
